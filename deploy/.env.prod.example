# Production .env для trial.kiberone.ru
# Копировать в корень проекта как .env (без префикса deploy/) и заполнить.

# --- Web -----------------------------------------------------------

# Публичный URL без слэша на конце. Должен совпадать с DNS записью.
BASE_URL=https://xn----7sbbaje0bckkpaqddfksce7m4g.xn--p1ai
# (Punycode для школа-программирования.рф — браузер декодирует обратно в кириллицу)

# СИЛЬНЫЙ пароль админки. Не оставляй дефолт kiber2026 на проде!
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(16))"
ADMIN_PASSWORD=ОБЯЗАТЕЛЬНО_ПОМЕНЯТЬ

# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ОБЯЗАТЕЛЬНО_ПОМЕНЯТЬ_НА_СЛУЧАЙНУЮ_СТРОКУ

# По умолчанию подставляется в форму создания сессии
DEFAULT_FILIAL=Naberezhnye Chelny

# --- Wazzup24 (WhatsApp Business) ---------------------------------

# Где взять: личный кабинет wazzup24.com → Настройки → API
# Если оба пусты — worker в dry-run, шлёт в лог вместо WhatsApp.
WAZZUP_API_KEY=
WAZZUP_CHANNEL_ID=

# --- s20.online (AlfaCRM) — автозаполнение формы по телефону ------

# Где взять: личный кабинет s20.online → Настройки → API
# Если пусто — поиск в CRM просто не показывается в админке.
S20_EMAIL=
S20_API_KEY=
S20_HOSTNAME=
S20_BRANCHES=

# --- Anthropic Claude (AI-отчёт через 24ч) ------------------------

# Где взять: https://console.anthropic.com → API Keys
# Если пусто — генерится fallback-отчёт по шаблону (без AI).
ANTHROPIC_API_KEY=

# --- Worker -------------------------------------------------------

# В проде оставь дефолты. Изменяй только для отладки.
VIDEO_DELAY_MINUTES=60
REPORT_DELAY_MINUTES=1440
WORKER_POLL_SECONDS=300
