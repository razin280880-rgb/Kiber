# --- Web server ---------------------------------------------------

# Базовый URL, по которому будет доступен сервер (используется в QR-кодах,
# ссылках шеринга и сообщениях Wazzup24). Без слэша на конце.
# Локально для теста: http://localhost:5000
# В проде: https://trial.kiberone.ru
BASE_URL=http://localhost:5000

# Пароль для входа в /admin (наставник пробного урока)
ADMIN_PASSWORD=kiber2026

# Подставляется в форму по умолчанию
DEFAULT_FILIAL=Naberezhnye Chelny

# Секрет для cookies/sessions Flask. В проде — заменить на длинную случайную строку.
SECRET_KEY=change-me-in-production-please

# --- Wazzup24 (worker отправки родителю через 1 час) -------------

# Если оба пустые — клиент в dry-run: сообщения пишутся в лог, не отправляются.
# Это удобно для отладки. Для прода — заполнить.
WAZZUP_API_KEY=
WAZZUP_CHANNEL_ID=

# --- s20.online (AlfaCRM) — поиск клиента по телефону --------------

# Если оба пусты — функция "Найти в CRM" в админке не показывается,
# наставник заполняет форму вручную.
S20_EMAIL=
S20_API_KEY=
S20_HOSTNAME=          # например: kiberonechelny.s20.online

# Маппинг филиал → branch_id (формат: 'Имя=id,Имя=id').
# branch_id берётся в CRM-панели. Пример:
# S20_BRANCHES=Naberezhnye Chelny=1,Kazan=2,Nizhnekamsk=3
S20_BRANCHES=

# --- Anthropic Claude (генерация отчёта через 24ч) ----------------

# Если пусто — отчёт генерируется по шаблону (fallback, без AI).
# Получить ключ: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# --- Worker -------------------------------------------------------

# Через сколько минут после finish сессии отправлять видео-сообщение
VIDEO_DELAY_MINUTES=60

# Через сколько минут отправлять персональный отчёт (по умолчанию — сутки)
REPORT_DELAY_MINUTES=1440

# Период опроса в режиме непрерывной работы (раз в сколько секунд проверять)
WORKER_POLL_SECONDS=300
